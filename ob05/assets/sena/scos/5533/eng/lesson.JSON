ducts.", "id": 3, "time": "35000"}]}}], "id": 1}], "exercises": [{"template_override": 1, "type": "WLC", "img_path": "", "questions": [], "_data": [{"type": "instructions", "contents": [{"content": "Do you know what a training session is?", "type": "Free Header Item"}, {"content": "Did you ever go to one?", "type": "Free Header Item"}, {"content": "I can talk about things, actions and events in the future.", "type": "Learning Outcomes"}, {"content": "I can talk about jobs and work.", "type": "Learning Outcomes"}, {"content": "I can use words to describe general quantities. ", "type": "Learning Outcomes"}]}, {"type": "group", "contents": [{"content": "Welcome", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "correct_feedback": "Correct", "attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}]}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "Let's do some training with Vanessa at the restaurant! ", "type": "free_type_text_area"}], "id": 0, "stimuli_ids": [0]}, {"template_override": 1, "type": "STI", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": "Vanessa is attending a session. What's it about? Why is she there?", "type": "text"}]}, {"type": "group", "contents": [{"content": "Content", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt