, "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Vanessa's Stories", "type": "lesson_name"}, {"content": "Two Bedrooms, Two Baths", "type": "unit_name"}, {"content": 10, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 3, "type": "lesson"}, {"content": "A2.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe rooms, homes and objects in buildings in common social and work situations.", "type": "primary"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_1"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_2"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_3"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_4"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_5"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_6"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_7"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "Have Got", "type": "heading"}, {"content": "You can use have got + infinitive to talk about obligation (something you must do) or talk about an arrangement for the future that is already made.", "type": "describer"}, {"content": "I have got to look through these listings.", "type": "example"}, {"content": "I have got to make a decision.", "type": "example"}, {"content": "I have got to go for an appointment in the morning.<br/>  <br/> <br/>", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Comparatives", "type": "heading"}, {"content": "When you compare two things, you use a <span class=\"strong\">comparative</span>. You can use <span class=\"italic\">than</span>. ", "type": "describer"}, {"content": "When comparing with <span class=\"strong\">than</span>, the adjective you use can change  depending on the number of syllables it has: <ul><li>1-syllable adjectives: add <span class=\"italic\">-er </span>to the adjective<span class=\"italic\"> cheap \u2192 cheap<span class=\"strong\">er</span></span></li><li>2-syllable adjectives ending in -y: change the -y to -<span class=\"italic\">ier </span><span class=\"italic\">busy \u2192 bus<span class=\"strong\">ier </span></span> </li><li>Adjectives with 3 or more syllables: use <span class=\"italic\">more</span> with the unchanged adjective<span class=\"italic\"> expensive \u2192 <span class=\"strong\">more</span> expensive</span>", "type": "text"}, {"content": "Certain adjectives have irregular forms in the comparative. <br> For example:  <br>good \u2192 better <br> bad \u2192 worse", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to compare", "type": "name"}, {"content": "to examine two or more things in order to show how they are the same or different from each other ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Let's compare the two listings. ", "type": "example"}, {"content": "engenn5le03ob10aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about rooms and objects in them.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "budget", "type": "name"}, {"content": "the money that is available to a person", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I have to think about my budget. ", "type": "example"}, {"content": "engenn5le03ob10aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "guest bathroom", "type": "name"}, {"content": "a small bathroom that contains a toilet and a sink", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Does the unit include a guest bathroom?", "type": "example"}, {"content": "engenn5le03ob10aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "ensuite", "type": "name"}, {"content": "a bathroom that is joined to a bedroom", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The apartment unit includes an ensuite.", "type": "example"}, {"content": "engenn5le03ob10aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "furniture", "type": "name"}, {"content": "large objects you use in a home", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The apartment includes furniture.", "type": "example"}, {"content": "engenn5le03ob10aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "full bathroom", "type": "name"}, {"content": "a bathroom that contains four key items: a bathtub, a shower, a toilet, and a sink  ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The condo includes a full bathroom.", "type": "example"}, {"content": "engenn5le03ob10aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "office space", "type": "name"}, {"content": "a room that provides a place to do work ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The condo includes an office space. ", "type": "example"}, {"content": "engenn5le03ob10aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to sleep on", "type": "name"}, {"content": "to think about something overnight before you make a decision ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I have got to sleep on this tonight.", "type": "example"}, {"content": "engenn5le03ob10aud08", "type": "audio"}]}, {"content": "engenn5le03ob10re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Choose a city in the world.", "type": "text"}, {"content": "Go on the Internet and find two classified ads for apartments in that city.", "type": "text"}, {"content": "Fill in the table.", "type": "text"}, {"content": "{\"rows\":6,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Apartment A &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Apartment B &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"How many square feet is it?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"How much is the rent?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Does it include any furniture?<br/> What else does it include?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Is there security?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"How many rooms are there?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}, {"content": "Use the information from the table to write 5-7 sentences.", "type": "text"}, {"content": "Use comparatives in your sentences.", "type": "text"}, {"content": "Read your sentences aloud to your class.<br/> <br/><br/>", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I compare apartments.", "type": "text"}, {"content": "I talk about rooms and objects.", "type": "text"}, {"content": "I read my sentences aloud.", "type": "text"}]}]}